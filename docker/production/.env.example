# Compatibility default: existing edge image; master pushes no longer update it.
# For upgrades, select an actually published vMAJOR.MINOR.PATCH or sha-<full SHA>.
IMAGE_TAG=edge
# Optionally override the full reference, including a digest, instead of IMAGE_TAG.
# STASH_IMAGE=ghcr.io/rzp-labs/vexxx-stash@sha256:<digest>
# Manual test images use a separate package (example naming format only):
# STASH_IMAGE=ghcr.io/rzp-labs/vexxx-stash-test:test-candidate-123456789-1

HOST_PORT=9999
STASH_PORT=9999
