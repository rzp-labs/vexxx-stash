+static int emit_hwaccel_metadata(DecoderPriv *dp, const AVFrame *frame)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+    const AVHWFramesContext *frames;
+    const char *format, *range, *space, *primaries, *transfer;
+    int written, flushed;
+
+    if (!desc || !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL) ||
+        !frame->hw_frames_ctx || frame->width <= 0 || frame->height <= 0) {
+        av_log(dp, AV_LOG_ERROR, "Hardware metadata requires an actual hardware frame.\n");
+        return AVERROR(EINVAL);
+    }
+    frames = (const AVHWFramesContext *)frame->hw_frames_ctx->data;
+    if (frames->format != frame->format)
+        return AVERROR(EINVAL);
+    format = av_get_pix_fmt_name(frames->sw_format);
+    range = av_color_range_name(frame->color_range);
+    space = av_color_space_name(frame->colorspace);
+    primaries = av_color_primaries_name(frame->color_primaries);
+    transfer = av_color_transfer_name(frame->color_trc);
+    if (!format || !range || !space || !primaries || !transfer)
+        return AVERROR(EINVAL);
+
+    /* Names are controlled libavutil enum strings; no source text or paths.
+     * Emit after decoder cropping and before filters, once for this decoder. */
+    flockfile(stdout);
+    written = fprintf(stdout,
+        "VEXXX_GPU_METADATA={\"width\":%d,\"height\":%d,"
+        "\"pix_fmt\":\"%s\",\"sample_aspect_ratio\":\"%d/%d\","
+        "\"color_range\":\"%s\",\"color_space\":\"%s\","
+        "\"color_primaries\":\"%s\",\"color_transfer\":\"%s\","
+        "\"frame_rate\":\"%d/%d\"}\n",
+        frame->width, frame->height, format,
+        frame->sample_aspect_ratio.num, frame->sample_aspect_ratio.den,
+        range, space, primaries, transfer,
+        dp->dec_ctx->framerate.num, dp->dec_ctx->framerate.den);
+    flushed = fflush(stdout);
+    funlockfile(stdout);
+    if (written < 0 || flushed != 0)
+        return AVERROR(EIO);
+    dp->hwaccel_metadata_emitted = 1;
+    return 0;
 }
 
