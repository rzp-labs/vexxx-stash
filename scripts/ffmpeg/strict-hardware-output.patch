+        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(hwaccel_output_format);
+
+        if (hwaccel_strict != 1 || st->codecpar->codec_type != AVMEDIA_TYPE_VIDEO ||
+            hwaccel_id != HWACCEL_GENERIC || hwaccel_device_type == AV_HWDEVICE_TYPE_NONE ||
+            !desc || !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL)) {
+            av_log(logctx, AV_LOG_ERROR, "Strict decoder selection requires explicit video hardware output.\n");
+            return AVERROR(EINVAL);
+        }
+    }
 
     opt_match_per_stream_str(logctx, &o->codec_names, s, st, &codec_name);
     if (codec_name) {
         int ret = find_codec(NULL, codec_name, st->codecpar->codec_type, 0, pcodec);
         if (ret < 0)
             return ret;
         st->codecpar->codec_id = (*pcodec)->id;
         if (recast_media && st->codecpar->codec_type != (*pcodec)->type)
             st->codecpar->codec_type = (*pcodec)->type;
