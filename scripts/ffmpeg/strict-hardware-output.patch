+static int hwaccel_output_required(const DecoderPriv *dp)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dp->hwaccel_output_format);
+
+    return dp->hwaccel_strict && dp->dec.type == AVMEDIA_TYPE_VIDEO &&
+           dp->hwaccel_id == HWACCEL_GENERIC && desc &&
+           (desc->flags & AV_PIX_FMT_FLAG_HWACCEL);
+}
+
+static int hwaccel_decoder_check(const DecoderPriv *dp, const AVCodec *codec)
+{
+    const AVCodecHWConfig *config;
+
+    if (!hwaccel_output_required(dp))
+        return 0;
+    for (int i = 0; (config = avcodec_get_hw_config(codec, i)); i++) {
+        if ((config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) &&
+            config->device_type == dp->hwaccel_device_type &&
+            config->pix_fmt == dp->hwaccel_output_format)
+            return 0;
+    }
+    av_log((void *)dp, AV_LOG_ERROR,
+           "Decoder %s has no %s hardware configuration for %s; "
+           "refusing software decoding.\n", codec->name,
+           av_hwdevice_get_type_name(dp->hwaccel_device_type),
+           av_get_pix_fmt_name(dp->hwaccel_output_format));
+    return AVERROR(ENOSYS);
+}
