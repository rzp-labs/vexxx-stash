# Local development settings previously stored in the tracked .env.
BROWSER=none
ESLINT_NO_DEV_ERRORS=true

# PostHog source map uploads (build-time only)
POSTHOG_API_KEY=your_personal_api_key
POSTHOG_PROJECT_ID=your_project_id
POSTHOG_HOST=your_posthog_host

# Public SDK settings embedded in the frontend bundle
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set false for builds that should not upload source maps (e.g. PR checks)
# POSTHOG_UPLOAD_REQUIRED=false
